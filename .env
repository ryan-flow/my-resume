# === 我的简历 — 配置文件 ===

# --- 应用 ---
PORT="3000"
SERVER_PORT="3001"
APP_URL="http://localhost:3000"

# --- 数据库 (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/postgres"

# --- 认证 ---
AUTH_SECRET="my-resume-secret-key-2026-change-in-production"

# --- AI (DeepSeek) ---
FLAG_ALLOW_UNSAFE_AI_BASE_URL="true"

# --- 邮件（禁用邮箱验证，简化登录）---
FLAG_DISABLE_EMAIL_AUTH="true"

# --- 存储（本地文件系统）---
# 不配置 S3，使用本地存储

# --- 功能开关 ---
FLAG_DISABLE_SIGNUPS="false"
FLAG_DISABLE_IMAGE_PROCESSING="false"
